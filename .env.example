# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (safe for browser use; never use service_role here)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Display name and upload safety limit
NEXT_PUBLIC_APP_NAME=IMDS Intelligence Control Center
MAX_IMPORT_FILE_MB=20

# SharePoint master workbook (server-only; read-only; see docs/SHAREPOINT_SETUP.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=sites/YourSite
SHAREPOINT_MASTER_FILE_PATH=Shared Documents/Master Data All IMDS Project.xlsx

# Power Automate bridges (server-only; never NEXT_PUBLIC_). See docs/POWER_AUTOMATE_IMDS_MASTER_SETUP.md
POWER_AUTOMATE_EXCEL_URL=
POWER_AUTOMATE_TRACKER_URL=
POWER_AUTOMATE_EMAIL_URL=
POWER_AUTOMATE_SECRET=

# Mail transport (use when Power Automate Premium / HTTP trigger is NOT available)
FLOW_SMTP_HOST=smtp.gmail.com
FLOW_SMTP_PORT=465
FLOW_SMTP_USER=
FLOW_SMTP_PASS=
FLOW_SMTP_FROM=
FLOW_INBOX_ADDRESS=

# Access requests & approval (server-only). See docs/ACCESS_AND_SECURITY.md
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=
STAFF_EMAIL_DOMAINS=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_FROM=
THROTTLE_SALT=
REQUIRE_EMAIL_CONFIRMATION=
