# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (safe for browser use; never use service_role here)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Display name and upload safety limit
NEXT_PUBLIC_APP_NAME=IMDS Intelligence Control Center
MAX_IMPORT_FILE_MB=20
NEXT_PUBLIC_ACCESS_REQUEST_EMAIL=

# SharePoint master workbook (server-only; read-only; see docs/SHAREPOINT_SETUP.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=sites/YourSite
SHAREPOINT_MASTER_FILE_PATH=Shared Documents/Master Data All IMDS Project.xlsx
